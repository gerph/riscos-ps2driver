PS2DriverState ps2_state;

#define PS2_MODHAND_REASON_CLAIM 6

typedef struct PS2PointerRecord
{
    struct PS2PointerRecord *next;
    uint32_t flags;
    uint8_t type;
    char name[10];
} PS2PointerRecord;

