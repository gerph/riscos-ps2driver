/*******************************************************************
 Function:      PS2_ClaimVectors
 Description:   Claim software and device vectors used by the driver.
 Parameters:    pw = module private word
 Returns:       error pointer, or NULL
 ******************************************************************/
static _kernel_oserror *PS2_ClaimVectors(void *pw)
{
    _kernel_oserror *error;

    error = _swix(OS_ClaimDeviceVector, _INR(0, 2), 14,
                  PS2_TxIRQ_Entry, &ps2_state.channels[0]);
    if (error != NULL)
        return error;
    error = _swix(OS_ClaimDeviceVector, _INR(0, 2), 15,
                  PS2_RxIRQ_Entry, &ps2_state.channels[0]);
    if (error != NULL)
        return error;

    if (ps2_state.port_count >= 2)
    {
        error = _swix(OS_ClaimDeviceVector, _INR(0, 2),
                      IOMD_MouseTxEmpty_DevNo, PS2_TxIRQ_Entry,
                      &ps2_state.channels[1]);
        if (error != NULL)
            return error;
        error = _swix(OS_ClaimDeviceVector, _INR(0, 2),
                      IOMD_MouseRxFull_DevNo, PS2_RxIRQ_Entry,
                      &ps2_state.channels[1]);
        if (error != NULL)
            return error;
    }

    error = _swix(OS_Claim, _INR(0, 2), PointerV, PointerV_Entry, pw);
    if (error != NULL)
        return error;
    error = _swix(OS_Claim, _INR(0, 2), KEYV, KeyV_Entry, pw);
    if (error == NULL)
        ps2_state.vectors_claimed = 1;
    return error;
}

/*******************************************************************
 Function:      PS2_ReleaseVectors
 Description:   Release all vectors claimed by this module.
 Parameters:    pw = module private word
 Returns:       none
 ******************************************************************/
static void PS2_ReleaseVectors(void *pw)
{
    if (!ps2_state.vectors_claimed)
        return;

    (void)_swix(OS_Release, _INR(0, 2), KEYV, KeyV_Entry, pw);
    (void)_swix(OS_Release, _INR(0, 2), PointerV, PointerV_Entry, pw);
    (void)_swix(OS_ReleaseDeviceVector, _INR(0, 2), 14,
                PS2_TxIRQ_Entry, &ps2_state.channels[0]);
    (void)_swix(OS_ReleaseDeviceVector, _INR(0, 2), 15,
                PS2_RxIRQ_Entry, &ps2_state.channels[0]);
    if (ps2_state.port_count >= 2)
    {
        (void)_swix(OS_ReleaseDeviceVector, _INR(0, 2),
                    IOMD_MouseTxEmpty_DevNo, PS2_TxIRQ_Entry,
                    &ps2_state.channels[1]);
        (void)_swix(OS_ReleaseDeviceVector, _INR(0, 2),
                    IOMD_MouseRxFull_DevNo, PS2_RxIRQ_Entry,
                    &ps2_state.channels[1]);
    }
    ps2_state.vectors_claimed = 0;
}

/*******************************************************************
 Function:      PS2_Start
 Description:   Initialise all channels and begin PS/2 device detection.
 Parameters:    none
 Returns:       none
 ******************************************************************/
static void PS2_Start(void)
{
    int index;

    /* Pyromaniac reports IOMD compatibility but does not map its registers. */
    if (_swix(OS_Module, _INR(0, 1), 18, "Pyromaniac") == NULL)
        return;
    if (ps2_state.hardware_running)
        return;
    ps2_state.hardware_running = 1;
    PS2Keyboard_Initialise();
    PS2Mouse_Initialise();
    for (index = 0; index < ps2_state.port_count; index++)
    {
        PS2HW_Initialise(&ps2_state.channels[index]);
        PS2Protocol_Initialise(&ps2_state.channels[index]);
        PS2Protocol_Start(&ps2_state.channels[index]);
    }
}

/*******************************************************************
 Function:      Mod_Init
 Description:   Initialise the PS/2 hardware driver.
 Parameters:    tail = command tail, podule_base = podule base, pw = private word
 Returns:       error pointer, or NULL
 ******************************************************************/
_kernel_oserror *Mod_Init(const char *tail, int podule_base, void *pw)
{
    _kernel_oserror *error;
    int pointer_type;

    (void)tail;
    (void)podule_base;
    ps2_state.port_count = 2;
    ps2_state.channels[0].port = PS2_PORT_KEYBOARD;
    ps2_state.channels[1].port = PS2_PORT_MOUSE;
    ps2_state.channels[2].port = PS2_PORT_PSEUDO;
    error = PS2_ClaimVectors(pw);
    if (error != NULL)
    {
        PS2_ReleaseVectors(pw);
        return error;
    }
    pointer_type = 0;
    if (_swix(OS_Pointer, _IN(0) | _OUT(0), 0, &pointer_type) == NULL &&
        pointer_type == PointerDevice_PS2Mouse)
        PS2_Start();
    dprintf("PS2Driver initialised\n");
    return NULL;
}

/*******************************************************************
 Function:      Mod_Final
 Description:   Disable PS/2 hardware and release all vectors.
 Parameters:    fatal = finalisation mode, podule_base = podule base, pw = private word
 Returns:       NULL
 ******************************************************************/
_kernel_oserror *Mod_Final(int fatal, int podule_base, void *pw)
{
    int index;

    (void)fatal;
    (void)podule_base;
    PS2_ReleaseVectors(pw);
    for (index = 0; index < ps2_state.port_count; index++)
        PS2HW_Disable(&ps2_state.channels[index]);
    ps2_state.hardware_running = 0;
    dprintf("PS2Driver finalised\n");
    return NULL;
}

/*******************************************************************
 Function:      PointerV_Handler
 Description:   Respond to PointerV requests for the PS/2 mouse.
 Parameters:    r = vector registers, pw = private word
 Returns:       NULL after claiming, or to pass on
 ******************************************************************/
int PointerV_Handler(_kernel_swi_regs *r, void *pw)
{
    int32_t delta_x;
    int32_t delta_y;
    PS2PointerRecord *record;
    uint32_t changed;
    uint32_t buttons;
    uint32_t button;
    static const uint32_t mouse_keys[3] = { 0x72, 0x71, 0x70 };

    (void)pw;
    if (r->r[0] == PointerReason_Identify)
    {
        record = NULL;
        if (_swix(OS_Module, _INR(0, 3) | _OUT(2), PS2_MODHAND_REASON_CLAIM,
                  0, sizeof(*record), &record) == NULL)
        {
            record->next = (PS2PointerRecord *)(uintptr_t)r->r[1];
            record->flags = 0;
            record->type = PointerDevice_PS2Mouse;
            record->name[0] = 'P';
            record->name[1] = 'S';
            record->name[2] = '2';
            record->name[3] = ' ';
            record->name[4] = 'm';
            record->name[5] = 'o';
            record->name[6] = 'u';
            record->name[7] = 's';
            record->name[8] = 'e';
            record->name[9] = '\0';
            r->r[1] = (int)(uintptr_t)record;
        }
        return 0;
    }
    if (r->r[0] == PointerReason_Selected)
    {
        if (r->r[1] == PointerDevice_PS2Mouse)
        {
            PS2_Start();
            PS2Mouse_Initialise();
        }
        return 0;
    }
    if (r->r[1] != PointerDevice_PS2Mouse)
        return 0;
    if (r->r[0] != PointerReason_Request &&
        r->r[0] != PointerReason_ExtRequest)
        return 0;

    delta_x = ps2_state.mouse.delta_x;
    delta_y = ps2_state.mouse.delta_y;
    ps2_state.mouse.delta_x = 0;
    ps2_state.mouse.delta_y = 0;
    r->r[2] = delta_x;
    r->r[3] = delta_y;
    if (r->r[0] == PointerReason_ExtRequest)
    {
        r->r[0] = -1;
        r->r[4] = ps2_state.mouse.alternate_x;
        r->r[5] = ps2_state.mouse.alternate_y;
        r->r[6] = ps2_state.mouse.buttons;
        ps2_state.mouse.alternate_x = 0;
        ps2_state.mouse.alternate_y = 0;
    }
    else
    {
        buttons = ps2_state.mouse.buttons;
        changed = buttons ^ ps2_state.mouse.last_buttons;
        ps2_state.mouse.last_buttons = buttons;
        for (button = 0; button < 3; button++)
        {
            if ((changed & (1U << button)) != 0)
                (void)_swix(OS_CallAVector, _INR(0, 1) | _IN(9),
                            (buttons & (1U << button)) ? KEYV_KeyPress : KEYV_KeyRelease,
                            mouse_keys[button], KEYV);
        }
    }
    return 1;
}

/*******************************************************************
 Function:      KeyV_Handler
 Description:   Process keyboard enable, LED, and pseudo-port calls.
 Parameters:    r = vector registers, pw = private word
 Returns:       NULL
 ******************************************************************/
int KeyV_Handler(_kernel_swi_regs *r, void *pw)
{
    int index;
    uint8_t leds;

    (void)pw;
    if (r->r[0] == KEYV_EnableKeyboard)
    {
        PS2_Start();
        ps2_state.keyboard_state &= ~PS2_STATE_RESET;
    }
    else if (r->r[0] == KEYV_UpdateLEDs)
    {
        leds = (uint8_t)r->r[1];
        leds = (uint8_t)((leds & ~5) | ((leds & 1) << 2) | ((leds & 4) >> 2));
        ps2_state.led_state = leds;
        for (index = 0; index < ps2_state.port_count; index++)
            PS2Protocol_SetLEDs(&ps2_state.channels[index], leds);
    }
    else if (r->r[0] == KEYV_PseudoRXInt)
        PS2Protocol_ReceiveByte((PS2Channel *)(uintptr_t)r->r[1],
                                (uint8_t)r->r[2]);
    else if (r->r[0] == KEYV_PseudoTXInt)
        PS2Protocol_TransmitInterrupt((PS2Channel *)(uintptr_t)r->r[1]);
    return (r->r[0] == KEYV_PseudoRXInt || r->r[0] == KEYV_PseudoTXInt);
}

/*******************************************************************
 Function:      PS2_TxIRQ_Handler
 Description:   Service a device-vector transmit interrupt.
 Parameters:    r = interrupt register block, pw = private word
 Returns:       zero to pass the interrupt on
 ******************************************************************/
int PS2_TxIRQ_Handler(_kernel_swi_regs *r, void *pw)
{
    (void)r;
    PS2Protocol_TransmitInterrupt((PS2Channel *)pw);
    return 0;
}

/*******************************************************************
 Function:      PS2_RxIRQ_Handler
 Description:   Service a device-vector receive interrupt.
 Parameters:    r = interrupt register block, pw = private word
 Returns:       zero to pass the interrupt on
 ******************************************************************/
int PS2_RxIRQ_Handler(_kernel_swi_regs *r, void *pw)
{
    PS2Channel *channel;
    uint8_t byte;

    channel = (PS2Channel *)pw;
    if (PS2HW_ReadByte(channel, &byte))
        PS2Protocol_ReceiveByte(channel, byte);
    return 0;
}
