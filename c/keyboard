/*******************************************************************
 Function:      PS2Keyboard_Initialise
 Description:   Reset scan-code and autorepeat-suppression state.
 Parameters:    none
 Returns:       none
 ******************************************************************/
void PS2Keyboard_Initialise(void)
{
    uint32_t index;

    ps2_state.keyboard_state = PS2_STATE_RESET;
    ps2_state.last_key = 0;
    for (index = 0; index < sizeof(ps2_state.key_down); index++)
        ps2_state.key_down[index] = 0;
}

/*******************************************************************
 Function:      PS2Keyboard_Report
 Description:   Send one translated key transition to KeyV.
 Parameters:    key = RISC OS low-level or HID key, pressed = transition type
 Returns:       none
 ******************************************************************/
static void PS2Keyboard_Report(uint32_t key, int pressed)
{
    if (key < 0x80)
        (void)_swix(OS_CallAVector, _INR(0, 1) | _IN(9),
                    pressed ? KEYV_KeyPress : KEYV_KeyRelease, key, KEYV);
    else if (key - 0x80 < sizeof(extended_key_map) / sizeof(extended_key_map[0]))
        (void)_swix(OS_CallAVector, _INR(0, 4) | _IN(9),
                    KEYV_StateChange, extended_key_map[key - 0x80],
                    pressed ? 1 : 0, KEYV_StateChange_SourceSimple, 0, KEYV);
}

/*******************************************************************
 Function:      PS2Keyboard_ReceiveByte
 Description:   Translate a set-2 scan-code byte, suppressing autorepeat.
 Parameters:    byte = received scan-code byte
 Returns:       none
 ******************************************************************/
void PS2Keyboard_ReceiveByte(uint8_t byte)
{
    const uint8_t *table;
    uint8_t key;
    uint8_t mask;
    int pressed;
    int special;

    if (byte == PS2_KEY_BAT)
    {
        ps2_state.keyboard_state |= PS2_STATE_RESET;
        return;
    }
    if (byte == PS2_KEY_ACK || ps2_state.keyboard_state & PS2_STATE_RESET)
        return;
    if (byte == PS2_KEY_UP)
    {
        ps2_state.keyboard_state |= PS2_STATE_KEYUP;
        return;
    }
    if (byte == PS2_KEY_SPECIAL)
    {
        ps2_state.keyboard_state |= PS2_STATE_SPECIAL;
        return;
    }
    if (byte == PS2_KEY_BREAK)
    {
        if (ps2_state.keyboard_state & PS2_STATE_BREAK)
        {
            ps2_state.keyboard_state &= ~PS2_STATE_BREAK;
            ps2_state.keyboard_state |= PS2_STATE_SPECIAL;
        }
        else
            ps2_state.keyboard_state |= PS2_STATE_BREAK;
        return;
    }
    if (byte >= sizeof(key_table))
    {
        ps2_state.keyboard_state = 0;
        return;
    }
    special = (ps2_state.keyboard_state & PS2_STATE_SPECIAL) != 0;
    table = special ? special_table : key_table;
    ps2_state.keyboard_state &= ~PS2_STATE_SPECIAL;
    key = table[byte];
    ps2_state.last_key = byte | (special ? 0x10000U : 0);
    if (key == PS2_KEY_UNMAPPED)
    {
        ps2_state.keyboard_state = 0;
        return;
    }
    mask = (uint8_t)(1U << (key & 7));
    pressed = (ps2_state.keyboard_state & PS2_STATE_KEYUP) == 0;
    ps2_state.keyboard_state &= ~PS2_STATE_KEYUP;
    if (pressed && (ps2_state.key_down[key >> 3] & mask) != 0)
        return;
    if (pressed)
        ps2_state.key_down[key >> 3] |= mask;
    else
        ps2_state.key_down[key >> 3] &= (uint8_t)~mask;
    PS2Keyboard_Report(key, pressed);
}
